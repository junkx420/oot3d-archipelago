 }
 
+// Archipelago Phase 0 experiment: a block-entry callback may change the
+// general registers of the block it observes, but writing r15 does not
+// redirect the dispatch. Redirects need a native function or block callback.
+void RedirectAndMarkBlockEntry(uint32_t pc,
+                               oot3d::recomp::a32::GuestState& state,
+                               oot3d::recomp::a32::MemoryBus& memory,
+                               void* user) {
+    static_cast<void>(memory);
+    auto& probe = *static_cast<BlockEntryProbe*>(user);
+    if (pc == kEntry) {
+        ++probe.Calls;
+        state.r[2] = 0x0000BEEFU;
+        state.r[15] = kEntry + 0x10U;
+    }
+}
+
+void TestBlockEntryCallbackRegisterWritesAndIgnoredRedirect() {
+    const auto registry = MakeTestRegistry();
+    TestHostServices services;
+    Oot3dNativeGame::NativeA32Process process(registry, services);
+    const std::array<uint8_t, 8> code{};
+    std::string error;
+    Expect(process.MapRegion(
+               {"text", kEntry, code.size(), false, true, code}, &error),
+           "map redirect block-entry text");
+    Expect(process.MapRegion({"data", kData, 0x100U, true, false, {}},
+                             &error),
+           "map redirect block-entry data");
+    Expect(process.CreatePrimaryThread(
+               {kEntry, kStack, 0x1000U, kTls, 0x100U, 0, 0, 0, 0},
+               &error),
+           "create redirect block-entry thread");
+    BlockEntryProbe probe;
+    process.SetBlockEntryCallback(&RedirectAndMarkBlockEntry, &probe, {kEntry});
+    const auto result = process.Run();
+    Expect(probe.Calls == 1U, "redirect probe must observe the entry block");
+    Expect(services.FirstSvc == 1U &&
+               result.Kind == Oot3dNativeGame::NativeA32ProcessRunKind::Waiting,
+           "a block-entry write to r15 must not redirect the dispatched block");
+    Expect(process.PrimaryThreadState().r[2] == 0x0000BEEFU,
+           "a block-entry register write must reach the observed block");
+}
+
